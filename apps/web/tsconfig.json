{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@app/*": ["./app/*"],
      "@env": ["./.env.ts"],
      "@env.server": ["./.env.server.ts"],
      "/env": ["../api/.env.ts"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.js",
    "../api/worker-configuration.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
